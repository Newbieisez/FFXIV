<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EZBuddy.BotBase</RootNamespace>
    <AssemblyName>EZBuddy.BotBase</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EZBuddy.Core\EZBuddy.Core.csproj" />
    <ProjectReference Include="..\EZBuddy.RebornBuddy\EZBuddy.RebornBuddy.csproj" />
    <PackageReference Include="RebornBuddy.ReferenceAssemblies" Version="1.0.904" PrivateAssets="all" />
  </ItemGroup>
</Project>
