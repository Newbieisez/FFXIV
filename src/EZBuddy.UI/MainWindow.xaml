<Window x:Class="EZBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="EZBuddy Unified Control"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/EZBuddyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <CollectionViewSource x:Key="NavigationView" Source="{Binding NavigationModules}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="#59462C"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Global header / telemetry -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="4"
                                Background="#241E14" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                            <TextBlock Text="EZ" Foreground="{StaticResource GoldBrightBrush}"
                                       FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EZBuddy" FontWeight="SemiBold" FontSize="15"/>
                                <Border Margin="9,0,0,0" Padding="7,2" CornerRadius="8"
                                        Background="#143A2D" BorderBrush="#345B4E" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ApplicationStatus}" FontSize="10" Foreground="#DDF8EC"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding CharacterName}"/><Run Text="  ·  "/><Run Text="{Binding ServerName}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="18,0">
                            <TextBlock Text="CURRENT ROUTINE" Style="{StaticResource CaptionStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource CrystalBlueBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding RoutineName}" Style="{StaticResource MetricValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="1" Height="26" Background="{StaticResource BorderBrush}"/>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="GIL EARNED" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding GilEarned, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                        <Border Width="1" Height="26" Background="{StaticResource BorderBrush}"/>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="SESSION" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding SessionRuntimeDisplay}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                        <Border Width="1" Height="26" Background="{StaticResource BorderBrush}"/>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="HOOKS / WARNINGS" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Style="{StaticResource MetricValueStyle}">
                                <Run Text="{Binding ActiveHooks}"/><Run Text=" / "/><Run Text="{Binding WarningCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Gentle Stop" Command="{Binding GentleStopCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0"/>
                        <Button Command="{Binding EmergencyStopCommand}"
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" Margin="0,0,6,0"/>
                                <TextBlock Text="STOP ALL"/>
                            </StackPanel>
                        </Button>
                        <Button Content="⚙" Style="{StaticResource IconButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="—" Style="{StaticResource IconButtonStyle}"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="□" Style="{StaticResource IconButtonStyle}"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="×" Style="{StaticResource IconButtonStyle}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border Grid.Column="0" Background="#151619"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource NavigationView}}" Margin="8,12">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="8,12,8,5"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NavButtonStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" Foreground="{StaticResource GoldBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                            <CheckBox Grid.Column="1" Margin="4,0,4,0" VerticalAlignment="Center"
                                                      Visibility="{Binding CanToggle, Converter={x:Static BooleanToVisibilityConverter.Instance}}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ToggleStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ENGINE" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Text="{Binding ApplicationStatus}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="▶" Command="{Binding ResumeCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Resume"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Primary workspace -->
                <Grid Grid.Column="1" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedWorkspace}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Unified automation control, telemetry and safe-stop orchestration"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonStyle}"/>
                    </Grid>

                    <!-- Hero pipeline -->
                    <Border Grid.Row="1" Style="{StaticResource GoldCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CURRENT EXECUTION PIPELINE" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Text="{Binding CurrentActivity}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,3" CornerRadius="10" Background="#152C35" BorderBrush="#275568" BorderThickness="1">
                                    <TextBlock Text="LIVE" Foreground="{StaticResource CrystalBlueBrush}" FontWeight="SemiBold" FontSize="10"/>
                                </Border>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PipelineSteps}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="235" Margin="0,0,9,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12"
                                                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1"
                                                    Background="#231F17" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource GoldBrightBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="30"/>
                                                <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{StaticResource CrystalBlueBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Activity Queue -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ACTIVITY QUEUE" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActivityQueue.Count, StringFormat={}{0} scheduled}"
                                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityQueue}" Style="{StaticResource CompactListBoxStyle}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18191D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="≡" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Category, StringFormat={}  ·  {0}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Padding="7,2" CornerRadius="8" BorderBrush="#4A4E57" BorderThickness="1" Background="#25272C" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StopCondition}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Diagnostics -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DIAGNOSTICS &amp; HOOKS" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Integrations}" Style="{StaticResource CompactListBoxStyle}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource CrystalBlueBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="9" Foreground="{StaticResource SuccessBrush}" Margin="8,2,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
