<UserControl x:Class="EZBuddy.UI.Views.FirstPlayableLoopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsFirstLoopWorkspace, Converter={StaticResource LoopBoolToVisibility}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/EZBuddyTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="LoopBoolToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FIRST PLAYABLE LOOP" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock Text="Configure &amp; Run EZBuddy" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock Text="Maintenance → Retainers → Inventory Relief → Reset-Aware Routines → Daily Progression → Duty Support / Trust → Idle"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Reload" Command="{Binding FirstLoop.ReloadCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Save" Command="{Binding FirstLoop.SaveCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Gentle Stop" Command="{Binding GentleStopCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="▶ Run Loop" Command="{Binding FirstLoop.RunCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource GoldCardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LOOP STATE" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding RunLoopState}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="STATUS" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding RunLoopStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding FirstLoop.StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding FirstLoop.SettingsPath}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="DUTY / LEVELING" Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="QUEUE / REGISTRATION ID" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.QueueDutyId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TERRITORY / MAP ID" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.DutyTerritoryId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Queue ID selects Duty Support/Trust entry. Territory ID is verified after zone-in before any in-instance movement runner starts."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="IN-INSTANCE PROFILE PATH" Style="{StaticResource CaptionStyle}"/>
                            <TextBox Text="{Binding FirstLoop.DutyProfilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,3" Padding="8,6"/>
                            <TextBlock Text=".xml = OrderBot handoff. .json = validated EZBuddy clean-room native route."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MODE" Style="{StaticResource CaptionStyle}"/>
                                    <ComboBox ItemsSource="{Binding FirstLoop.DutyModes}"
                                              SelectedItem="{Binding FirstLoop.DutyMode, Mode=TwoWay}"
                                              Margin="0,4,0,8" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TRUST ID" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.TrustId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TARGET LEVEL" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.TargetLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MAX RUNS" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.MaxRuns, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="POST-DUTY LOOT" Style="{StaticResource CaptionStyle}"/>
                                    <ComboBox ItemsSource="{Binding FirstLoop.DutyLootActions}"
                                              SelectedItem="{Binding FirstLoop.DutyLootAction, Mode=TwoWay}"
                                              Margin="0,4,0,8" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PASS AT ≤ FREE SLOTS" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.DutyLootPassAtOrBelowFreeSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="CLEAN-ROOM ROUTE RECORDER" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock Text="Developer tool: walk the route manually while EZBuddy samples movement and observations on the BotBase tick."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,7"/>
                                    <TextBlock Text="ROUTE NAME" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.RouteRecorderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,7" Padding="8,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MIN LEVEL" Style="{StaticResource CaptionStyle}"/>
                                            <TextBox Text="{Binding FirstLoop.RouteRecorderMinimumLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,7" Padding="8,6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="MAX LEVEL" Style="{StaticResource CaptionStyle}"/>
                                            <TextBox Text="{Binding FirstLoop.RouteRecorderMaximumLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,7" Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,2,0,5">
                                        <Button Content="● Start Recorder" Command="{Binding FirstLoop.StartRouteRecorderCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,5"/>
                                        <Button Content="Capture Target" Command="{Binding FirstLoop.CaptureRouteTargetCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,7,5"/>
                                        <Button Content="Stop &amp; Save" Command="{Binding FirstLoop.StopRouteRecorderCommand}" Style="{StaticResource IconButtonStyle}" Margin="0,0,7,5"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding FirstLoop.RouteRecorderStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap"/>
                                    <TextBlock Text="Boss casts are stored as observations only. They are not promoted to stack/gaze/avoidance rules until explicitly validated."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="MAINTENANCE &amp; INVENTORY" Style="{StaticResource SectionTitleStyle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DUTY FREE-SLOT FLOOR" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.MinimumDutyFreeSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="INVENTORY TARGET" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.InventoryTargetFreeSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RETAINER FREE-SLOT FLOOR" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.MinimumRetainerFreeSlots, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REPAIR BELOW %" Style="{StaticResource CaptionStyle}"/>
                                    <TextBox Text="{Binding FirstLoop.AutoRepairThresholdPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox Content="Auto repair gear" IsChecked="{Binding FirstLoop.AutoRepairGear}" Margin="0,0,18,4"/>
                                <CheckBox Content="Auto extract materia" IsChecked="{Binding FirstLoop.AutoExtractMateria}" Margin="0,0,18,4"/>
                            </WrapPanel>

                            <TextBlock Text="FOOD ITEM ID" Style="{StaticResource CaptionStyle}"/>
                            <TextBox Text="{Binding FirstLoop.FoodItemId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6" Padding="8,6"/>
                            <CheckBox Content="Require Well Fed before duty work" IsChecked="{Binding FirstLoop.RequireWellFed}" Margin="0,0,0,10"/>

                            <TextBlock Text="APPROVED GC EXPERT DELIVERY ITEM IDS" Style="{StaticResource CaptionStyle}"/>
                            <TextBox Text="{Binding FirstLoop.ApprovedExpertDeliveryItemIds, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,4" Padding="8,6" AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
                            <TextBlock Text="Comma-separated allowlist only. EZBuddy will not auto-turn-in unapproved gear."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RESET-AWARE DAILY &amp; WEEKLY ROUTINES" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="These routines are opt-in, tracked per character, and only requeue after their FFXIV daily/weekly reset. A failed or ambiguous destructive pass is not automatically repeated."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,10"/>

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Content="Daily GC Expert Delivery" IsChecked="{Binding FirstLoop.RunGrandCompanyExpertDeliveryDaily}" Margin="0,0,22,6"/>
                            <CheckBox Content="Daily Venture Refill" IsChecked="{Binding FirstLoop.RunVentureRefillDaily}" Margin="0,0,22,6"/>
                            <CheckBox Content="Weekly Custom Deliveries" IsChecked="{Binding FirstLoop.RunCustomDeliveriesWeekly}" Margin="0,0,22,6"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VENTURE MINIMUM" Style="{StaticResource CaptionStyle}"/>
                                <TextBox Text="{Binding FirstLoop.VentureMinimumQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VENTURE TARGET" Style="{StaticResource CaptionStyle}"/>
                                <TextBox Text="{Binding FirstLoop.VentureTargetQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CUSTOM DELIVERY CRAFTING CLASS" Style="{StaticResource CaptionStyle}"/>
                                <ComboBox ItemsSource="{Binding FirstLoop.CustomDeliveryCraftingClasses}"
                                          SelectedItem="{Binding FirstLoop.CustomDeliveryCraftingClass, Mode=TwoWay}"
                                          Margin="0,4,0,0" Padding="6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CUSTOM DELIVERY CLIENT KEYS" Style="{StaticResource CaptionStyle}"/>
                        <TextBox Text="{Binding FirstLoop.CustomDeliveryClientKeys, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,4" Padding="8,6" TextWrapping="Wrap"/>
                        <TextBlock Text="Comma-separated selection: zhloe-aliapoh, mnaago, kurenai, adkiragh, kaishirr, ehll-tou, charlemend, ameliance, anden, margrat, nitowikwe, tiisol-ja. Only selected clients are passed to the Llama workflow."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="Daily GC Expert Delivery requires the approved item-ID allowlist above. If both GC Daily and Venture Refill are enabled, Venture Refill will not run a second Expert Delivery fallback in the same loop."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="LOOP STAGES" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Maintenance" IsChecked="{Binding FirstLoop.RunMaintenance}" Margin="0,0,18,8"/>
                            <CheckBox Content="Retainers" IsChecked="{Binding FirstLoop.RunRetainers}" Margin="0,0,18,8"/>
                            <CheckBox Content="Inventory Relief" IsChecked="{Binding FirstLoop.RunInventoryPressureRelief}" Margin="0,0,18,8"/>
                            <CheckBox Content="Daily Progression" IsChecked="{Binding FirstLoop.RunDailyProgression}" Margin="0,0,18,8"/>
                            <CheckBox Content="Duty Loop" IsChecked="{Binding FirstLoop.RunDutyLoop}" Margin="0,0,18,8"/>
                            <CheckBox Content="Return to Idle" IsChecked="{Binding FirstLoop.ReturnToIdle}" Margin="0,0,18,8"/>
                        </WrapPanel>
                        <TextBlock Text="Combat remains delegated to Magitek. Native route execution issues no movement while BossBoundary combat is active; destructive GC actions remain allowlist-only."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
